{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "maya-server",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  // A Worker's fetch to another Worker in the same account (HAKSAI's, on
  // workers.dev) is refused with a 404 (error 1042) unless the request is sent
  // as if from the public internet. That path also keeps Access in front of
  // HAKSAI, which is what we want: the service token is still checked there.
  "compatibility_flags": ["global_fetch_strictly_public"],
  // The workers.dev address is the only way in (decided 2026-09-13: gakky.jp's
  // DNS is not on Cloudflare, so a Worker cannot sit at maya.gakky.jp). It is
  // protected twice: Cloudflare Access in front, and src/access.ts inside.
  "workers_dev": true,
  // Preview URLs would be a second door, one Access is not configured for.
  "preview_urls": false,
  "vars": {
    // Switched off gemini-3.6-flash on 2026-09-14. Its free-tier daily cap is
    // 20 requests, measured by the president in real use, and a consultation
    // that calls a tool spends two of them. Flash-Lite has room to spare.
    // The cost is arithmetic: 3.6 checked the numbers, Lite is directionally
    // right but does not (docs/LLM_INTEGRATION.md). Revisit on a paid key.
    "MODEL": "gemini-3.5-flash-lite",
    // Starting values only. The settings screen can change all three without a
    // redeploy; whatever it saves lives in D1 and wins (src/memory/settings.ts).
    "PREFER_FREE": "true",
    // On since 2026-09-14: the free tier stops at 20 requests a day, so a
    // consultation should carry on with the paid key rather than fail. Only a
    // rate limit triggers it, never an auth error or a network fault.
    "ALLOW_PAID_FALLBACK": "true",
    "PAID_DAILY_LIMIT_YEN": "50",
    // How much one model round may write, thinking included. 2048 has been the
    // cap since v0.1; a longer answer (a list of ten rows) needs more room only if
    // the log (`wrangler tail`, evt maya_turn) shows finishReason MAX_TOKENS or
    // thoughtsTokens eating most of it. Raise it here and redeploy to try.
    "MAX_OUTPUT_TOKENS": "2048",
    // HAKSAI Central の読み取り専用MCP（別のWorker、別のAccessアプリ）。住所は
    // 秘密ではない。入るためのサービストークンだけが秘密で、
    // `wrangler secret put HAKSAI_MCP_CLIENT_ID` / `..._SECRET` に置く。電話に
    // 置かないのは、アプリは開けられるが Worker の秘密は開けられないため。
    // 三つが揃うまで、在庫の道具は相談に出てこない（src/haksai.ts）。
    "HAKSAI_MCP_URL": "https://haksai-mcp.koji330.workers.dev/mcp",
    // Cloudflare Access. Neither value is a secret. Until ACCESS_AUD is filled
    // with the Access application's audience tag, the server refuses every
    // request (src/access.ts), so deploying before Access exists is safe.
    "ACCESS_TEAM_DOMAIN": "https://morning-block-80c5.cloudflareaccess.com",
    "ACCESS_AUD": "2377e499cb2f02aca2a30434ebf3c2038f428956f167083637a218ed7d78c668"
  },
  "d1_databases": [
    {
      "binding": "MAYA_DB",
      "database_name": "maya",
      // Created on Cloudflare 2026-09-13 in APAC. An id, not a secret.
      "database_id": "11ed662b-5540-43ca-80cb-3b6c9654404e",
      "migrations_dir": "migrations"
    }
  ]
}
