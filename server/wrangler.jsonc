{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "maya-server",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  // Reached only through the hostname Cloudflare Access protects. The
  // workers.dev address would be a second door with no lock on it.
  "workers_dev": false,
  "vars": {
    "MODEL": "gemini-3.6-flash",
    "PREFER_FREE": "true",
    "ALLOW_PAID_FALLBACK": "false",
    "PAID_DAILY_LIMIT_YEN": "50",
    // Cloudflare Access. Neither value is a secret. Until ACCESS_AUD is filled
    // with the Access application's audience tag, the server refuses every
    // request (src/access.ts), so deploying before Access exists is safe.
    "ACCESS_TEAM_DOMAIN": "https://morning-block-80c5.cloudflareaccess.com",
    "ACCESS_AUD": ""
  },
  "d1_databases": [
    {
      "binding": "MAYA_DB",
      "database_name": "maya",
      // Placeholder for local development. Replaced with the real id when the
      // database is created on Cloudflare, which is a separate, confirmed step.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ]
}
